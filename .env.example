# CMS API Configuration
CMS_API_URL=http://localhost/cms_dupe/public/api/v1
# or use your Laragon domain: http://cms-dupe.test/api/v1

# Player Configuration
PLAYER_CODE=PLR-XXXXXXXX
PLAYER_NAME=My TV Screen

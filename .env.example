# Display Settings
SCREEN_RESOLUTION=1920x1080
FULLSCREEN=True
ORIENTATION=landscape

# Cache Settings
CACHE_DIR=storage/cache
MAX_CACHE_SIZE_MB=2000

# Heartbeat Settings
HEARTBEAT_INTERVAL=30  # seconds

# Debug
DEBUG=False
LOG_LEVEL=INFO
